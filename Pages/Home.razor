@page "/"
@using System.Net.Http.Json
@using BlazorWasmBrasilApiCep.Models
@inject HttpClient Http

<PageTitle>Consulta CEP - BrasilAPI</PageTitle>

<h1>Consulta de CEP com Blazor WebAssembly</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <label for="cepInput" class="form-label">Digite o CEP:</label>
        <input id="cepInput" class="form-control" @bind="cepDigitado" placeholder="Ex: 01001000" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="ConsultarCep" disabled="@carregando">
            @(carregando ? "Buscando..." : "Consultar")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger mt-3">
        @mensagemErro
    </div>
}

@if (dadosCep != null)
{
    <div class="mt-4">
        <h4 style="color: #2e7d32;">Endereço Encontrado</h4>
        <p class="mb-1"><strong>CEP:</strong> @dadosCep.cep</p>
        <p class="mb-1"><strong>Logradouro:</strong> @dadosCep.street</p>
        <p class="mb-1"><strong>Bairro:</strong> @dadosCep.neighborhood</p>
        <p class="mb-1"><strong>Cidade:</strong> @dadosCep.city (@dadosCep.state)</p>
        <p class="mb-3"><strong>Serviço:</strong> @dadosCep.service</p>

        <p class="text-secondary mt-3 mb-1">Dados do IBGE</p>
        <p class="mb-1"><strong>Cidade IBGE:</strong> @dadosCep.ibge?.city</p>
        <p class="mb-1"><strong>Estado IBGE:</strong> @dadosCep.ibge?.state</p>
    </div>
}

@code {
    private string? cepDigitado;
    private Cep? dadosCep;
    private string? mensagemErro;
    private bool carregando = false;

    private async Task ConsultarCep()
    {
        mensagemErro = string.Empty;
        dadosCep = null;

        if (string.IsNullOrWhiteSpace(cepDigitado))
        {
            mensagemErro = "Por favor, digite um CEP.";
            return;
        }

        // Remove caracteres não numéricos
        string cepFormatado = new string(cepDigitado.Where(char.IsDigit).ToArray());

        if (cepFormatado.Length != 8)
        {
            mensagemErro = "O CEP deve conter exatamente 8 dígitos.";
            return;
        }

        carregando = true;

        try
        {
            dadosCep = await Http.GetFromJsonAsync<Cep>($"api/cep/v1/{cepFormatado}");

            if (dadosCep == null || string.IsNullOrEmpty(dadosCep.cep))
            {
                mensagemErro = "CEP não encontrado.";
                dadosCep = null;
            }
        }
        catch (HttpRequestException)
        {
            mensagemErro = "CEP não encontrado ou erro ao consultar a BrasilAPI.";
            dadosCep = null;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Ocorreu um erro: {ex.Message}";
            dadosCep = null;
        }
        finally
        {
            carregando = false;
        }
    }
}
